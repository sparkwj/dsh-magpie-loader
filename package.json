{
  "name": "dsh-magpie-loader",
  "version": "0.2.1",
  "type": "module",
  "description": "Starts magpie when DeepSeek Harness starts and stops it when the Harness exits.",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.png",
    "./client": "./client.js"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.png",
    "README.zh-CN.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sparkwj/dsh-magpie-loader.git"
  },
  "homepage": "https://github.com/sparkwj/dsh-magpie-loader#readme",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "magpie",
    "plugin"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh-typert-protocol": "*",
    "@deepseek-ai/dsh-client-ui-primitives": "*"
  }
}
