{
  "name": "dsh-magpie-loader",
  "version": "1.0.0",
  "type": "module",
  "description": "Starts magpie when DeepSeek Harness starts and stops it when the Harness exits.",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon-256.png"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon-256.png",
    "README.zh-CN.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sparkwj/dsh-magpie-loader.git"
  },
  "homepage": "https://github.com/sparkwj/dsh-magpie-loader#readme",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "magpie",
    "plugin"
  ]
}
